@model List<ProjekatWeb.Models.Korisnik>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Users</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #0f0f1a;
            color: white;
            min-height: 100vh;
        }

        nav {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nav-logo {
            font-size: 22px;
            font-weight: 700;
            color: #e94560;
            text-decoration: none;
        }

        .nav-links a {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            margin-left: 20px;
            font-size: 14px;
        }

            .nav-links a:hover {
                color: #e94560;
            }

        .btn-red {
            background: #e94560;
            color: white !important;
            padding: 8px 18px;
            border-radius: 6px;
        }

        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        h2 {
            font-size: 28px;
        }

            h2 span {
                color: #e94560;
            }

        .btn-dodaj {
            padding: 10px 22px;
            background: linear-gradient(135deg, #e94560, #c62a47);
            color: white;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
        }

        .search-box {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 14px;
            padding: 20px 25px;
            margin-bottom: 25px;
        }

        .search-row {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

            .search-row input, .search-row select {
                flex: 1;
                min-width: 140px;
                padding: 10px 14px;
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.15);
                border-radius: 8px;
                color: white;
                font-size: 14px;
                outline: none;
            }

                .search-row input::placeholder {
                    color: rgba(255,255,255,0.35);
                }

                .search-row select option {
                    background: #16213e;
                }

        .btn-search {
            padding: 10px 24px;
            background: linear-gradient(135deg, #e94560, #c62a47);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
        }

        .btn-reset {
            padding: 10px 18px;
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.7);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 8px;
            text-decoration: none;
            font-size: 14px;
        }

        .sort-bar {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

            .sort-bar span {
                color: rgba(255,255,255,0.5);
                font-size: 14px;
            }

            .sort-bar select {
                padding: 8px 14px;
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.15);
                border-radius: 8px;
                color: white;
                font-size: 14px;
                outline: none;
            }

                .sort-bar select option {
                    background: #16213e;
                }

        .greska {
            background: rgba(233,69,96,0.2);
            border: 1px solid rgba(233,69,96,0.5);
            color: #ff6b8a;
            padding: 12px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: rgba(255,255,255,0.08);
            padding: 12px 16px;
            text-align: left;
            font-size: 13px;
            color: rgba(255,255,255,0.5);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        td {
            padding: 14px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            font-size: 14px;
        }

        tr:hover td {
            background: rgba(255,255,255,0.03);
        }

        .badge-gost {
            background: rgba(116,185,255,0.2);
            color: #74b9ff;
            border: 1px solid rgba(116,185,255,0.4);
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
        }

        .badge-domacin {
            background: rgba(46,213,115,0.2);
            color: #2ed573;
            border: 1px solid rgba(46,213,115,0.4);
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 11px;
        }

        .actions {
            display: flex;
            gap: 8px;
        }

        .btn-edit {
            padding: 6px 14px;
            background: rgba(116,185,255,0.15);
            border: 1px solid rgba(116,185,255,0.4);
            color: #74b9ff;
            border-radius: 6px;
            text-decoration: none;
            font-size: 12px;
        }

        .btn-del {
            padding: 6px 14px;
            background: rgba(233,69,96,0.15);
            border: 1px solid rgba(233,69,96,0.4);
            color: #ff6b8a;
            border-radius: 6px;
            cursor: pointer;
            font-size: 12px;
        }

            .btn-del:hover {
                background: rgba(233,69,96,0.3);
            }

        .empty {
            text-align: center;
            padding: 60px;
            color: rgba(255,255,255,0.3);
        }
    </style>
</head>
<body>
    <nav>
        <a class="nav-logo" href="/Admin/Index">&#9881; Admin Panel</a>
        <div class="nav-links">
            <a href="/Admin/Index">Dashboard</a>
            <a href="/Korisnik/Odjava" class="btn-red">Sign Out</a>
        </div>
    </nav>
    <div class="container">
        <div class="page-header">
            <h2>Manage <span>Users</span></h2>
            <a href="/Admin/DodajDomacina" class="btn-dodaj">+ Add Host</a>
        </div>

        @if (TempData["Greska"] != null)
        {<div class="greska">@TempData["Greska"]</div>}

        <div class="search-box">
            <form method="get" action="/Admin/Korisnici">
                <div class="search-row">
                    <input type="text" name="ime" placeholder="First name..." value="@ViewBag.ime" />
                    <input type="text" name="prezime" placeholder="Last name..." value="@ViewBag.prezime" />
                    <input type="text" name="datumOd" placeholder="From (dd/MM/yyyy)" value="@ViewBag.datumOd" />
                    <input type="text" name="datumDo" placeholder="To (dd/MM/yyyy)" value="@ViewBag.datumDo" />
                    <select name="uloga">
                        <option value="">All Roles</option>
                        <option value="Gost" @(ViewBag.uloga == "Gost" ? "selected" : "")>Guest</option>
                        <option value="Domacin" @(ViewBag.uloga == "Domacin" ? "selected" : "")>Host</option>
                    </select>
                    <button type="submit" class="btn-search">Search</button>
                    <a href="/Admin/Korisnici" class="btn-reset">Reset</a>
                </div>
            </form>
        </div>

        <div class="sort-bar">
            <span>Sort:</span>
            <form method="get" action="/Admin/Korisnici" id="sortForm">
                <input type="hidden" name="ime" value="@ViewBag.ime" />
                <input type="hidden" name="prezime" value="@ViewBag.prezime" />
                <input type="hidden" name="uloga" value="@ViewBag.uloga" />
                <select name="sortBy" onchange="document.getElementById('sortForm').submit()">
                    <option value="">Default</option>
                    <option value="ime_asc" @(ViewBag.sortBy == "ime_asc" ? "selected" : "")>Name A-Z</option>
                    <option value="ime_desc" @(ViewBag.sortBy == "ime_desc" ? "selected" : "")>Name Z-A</option>
                    <option value="datum_asc" @(ViewBag.sortBy == "datum_asc" ? "selected" : "")>Birth Date Asc</option>
                    <option value="datum_desc" @(ViewBag.sortBy == "datum_desc" ? "selected" : "")>Birth Date Desc</option>
                    <option value="uloga_asc" @(ViewBag.sortBy == "uloga_asc" ? "selected" : "")>Role Asc</option>
                    <option value="uloga_desc" @(ViewBag.sortBy == "uloga_desc" ? "selected" : "")>Role Desc</option>
                </select>
            </form>
        </div>

        @if (Model.Count == 0)
        {
            <div class="empty"><p>No users found.</p></div>
        }
        else
        {
            <table>
                <tr>
                    <th>Username</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Birth Date</th>
                    <th>Role</th>
                    <th>Actions</th>
                </tr>
                @foreach (var k in Model)
                {
                    <tr>
                        <td>@k.KorisnickoIme</td>
                        <td>@k.Ime @k.Prezime</td>
                        <td>@k.Email</td>
                        <td>@k.DatumRodjenja</td>
                        <td><span class="badge-@k.TipKorisnika.ToString().ToLower()">@k.TipKorisnika</span></td>
                        <td>
                            <div class="actions">
                                <a href="/Admin/IzmeniKorisnika?korisnickoIme=@k.KorisnickoIme" class="btn-edit">Edit</a>
                                <form method="post" action="/Admin/ObrisiKorisnika">
                                    <input type="hidden" name="korisnickoIme" value="@k.KorisnickoIme" />
                                    <button type="submit" class="btn-del" onclick="return confirm('Delete this user?')">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </table>
        }
    </div>
</body>
</html>