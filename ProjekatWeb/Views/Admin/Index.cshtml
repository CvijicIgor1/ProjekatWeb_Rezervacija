@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Admin Panel</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: #0f0f1a;
            color: white;
            min-height: 100vh;
        }

        nav {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255,255,255,0.1);
            padding: 15px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .nav-logo {
            font-size: 22px;
            font-weight: 700;
            color: #e94560;
            text-decoration: none;
        }

        .nav-links a {
            color: rgba(255,255,255,0.7);
            text-decoration: none;
            margin-left: 20px;
            font-size: 14px;
        }

            .nav-links a:hover {
                color: #e94560;
            }

        .btn-red {
            background: #e94560;
            color: white !important;
            padding: 8px 18px;
            border-radius: 6px;
        }

        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        h2 {
            font-size: 28px;
            margin-bottom: 8px;
        }

            h2 span {
                color: #e94560;
            }

        .subtitle {
            color: rgba(255,255,255,0.5);
            margin-bottom: 35px;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 14px;
            padding: 25px;
            text-align: center;
            text-decoration: none;
            transition: transform 0.3s, border-color 0.3s;
        }

            .stat-card:hover {
                transform: translateY(-4px);
                border-color: #e94560;
            }

        .stat-icon {
            font-size: 36px;
            margin-bottom: 12px;
        }

        .stat-number {
            font-size: 36px;
            font-weight: 700;
            color: #e94560;
            margin-bottom: 6px;
        }

        .stat-label {
            color: rgba(255,255,255,0.5);
            font-size: 14px;
        }

        .menu {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .menu-item {
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 14px;
            padding: 25px 30px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 16px;
            transition: transform 0.3s, border-color 0.3s;
        }

            .menu-item:hover {
                transform: translateY(-3px);
                border-color: #e94560;
            }

        .menu-icon {
            font-size: 28px;
        }

        .menu-text h3 {
            font-size: 17px;
            color: white;
            margin-bottom: 4px;
        }

        .menu-text p {
            font-size: 13px;
            color: rgba(255,255,255,0.4);
        }
    </style>
</head>
<body>
    <nav>
        <a class="nav-logo" href="/Admin/Index">&#9881; Admin Panel</a>
        <div class="nav-links">
            <a href="/Home/Index">Home</a>
            <a href="/Admin/Profil">Admin Profile</a>
            <a href="/Korisnik/Odjava" class="btn-red">Sign Out</a>
        </div>
    </nav>
    <div class="container">
        <h2>Admin <span>Dashboard</span></h2>
        <p class="subtitle">Welcome, @Session["korisnik"]</p>

        <div class="stats">
            <a href="/Admin/Korisnici" class="stat-card">
                <div class="stat-icon">&#128100;</div>
                <div class="stat-number">@ViewBag.BrojKorisnika</div>
                <div class="stat-label">Users</div>
            </a>
            <a href="/Admin/Objekti" class="stat-card">
                <div class="stat-icon">&#127968;</div>
                <div class="stat-number">@ViewBag.BrojObjekta</div>
                <div class="stat-label">Properties</div>
            </a>
            <a href="/Admin/Rezervacije" class="stat-card">
                <div class="stat-icon">&#128197;</div>
                <div class="stat-number">@ViewBag.BrojRezervacija</div>
                <div class="stat-label">Reservations</div>
            </a>
            <a href="/Admin/Recenzije" class="stat-card">
                <div class="stat-icon">&#11088;</div>
                <div class="stat-number">@ViewBag.BrojRecenzija</div>
                <div class="stat-label">Pending Reviews</div>
            </a>
        </div>

        <div class="menu">
            <a href="/Admin/Korisnici" class="menu-item">
                <div class="menu-icon">&#128100;</div>
                <div class="menu-text"><h3>Manage Users</h3><p>View, edit and delete guests and hosts</p></div>
            </a>
            <a href="/Admin/Objekti" class="menu-item">
                <div class="menu-icon">&#127968;</div>
                <div class="menu-text"><h3>Manage Properties</h3><p>View, edit and delete all properties</p></div>
            </a>
            <a href="/Admin/Rezervacije" class="menu-item">
                <div class="menu-icon">&#128197;</div>
                <div class="menu-text"><h3>Manage Reservations</h3><p>Approve or cancel reservations</p></div>
            </a>
            <a href="/Admin/Recenzije" class="menu-item">
                <div class="menu-icon">&#11088;</div>
                <div class="menu-text"><h3>Manage Reviews</h3><p>Approve or reject guest reviews</p></div>
            </a>
        </div>
    </div>
</body>
</html>