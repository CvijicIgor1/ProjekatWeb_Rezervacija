@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Register</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .forma {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            padding: 45px 40px;
            border-radius: 16px;
            border: 1px solid rgba(255,255,255,0.1);
            width: 420px;
            box-shadow: 0 25px 45px rgba(0,0,0,0.3);
            margin: 30px 0;
        }

        .logo {
            text-align: center;
            font-size: 36px;
            margin-bottom: 15px;
        }

        h2 {
            text-align: center;
            color: white;
            margin-bottom: 8px;
            font-size: 24px;
            font-weight: 600;
        }

        .subtitle {
            text-align: center;
            color: rgba(255,255,255,0.5);
            font-size: 14px;
            margin-bottom: 30px;
        }

        .input-group {
            margin-bottom: 14px;
        }

            .input-group label {
                display: block;
                color: rgba(255,255,255,0.7);
                font-size: 13px;
                margin-bottom: 6px;
            }

            .input-group input,
            .input-group select {
                width: 100%;
                padding: 12px 16px;
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.15);
                border-radius: 8px;
                color: white;
                font-size: 15px;
                outline: none;
                transition: border 0.3s;
            }

                .input-group input::placeholder {
                    color: rgba(255,255,255,0.3);
                }

                .input-group input:focus,
                .input-group select:focus {
                    border-color: #e94560;
                    background: rgba(255,255,255,0.12);
                }

                .input-group select option {
                    background: #16213e;
                    color: white;
                }

        .row {
            display: flex;
            gap: 12px;
        }

            .row .input-group {
                flex: 1;
            }

        button {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #e94560, #c62a47);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            margin-top: 8px;
            transition: opacity 0.3s, transform 0.1s;
            letter-spacing: 0.5px;
        }

            button:hover {
                opacity: 0.9;
                transform: translateY(-1px);
            }

            button:active {
                transform: translateY(0);
            }

        .greska {
            background: rgba(233, 69, 96, 0.2);
            border: 1px solid rgba(233, 69, 96, 0.5);
            color: #ff6b8a;
            text-align: center;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 16px;
            font-size: 14px;
        }

        .divider {
            text-align: center;
            color: rgba(255,255,255,0.3);
            margin: 20px 0;
            font-size: 13px;
            position: relative;
        }

            .divider::before, .divider::after {
                content: '';
                position: absolute;
                top: 50%;
                width: 38%;
                height: 1px;
                background: rgba(255,255,255,0.15);
            }

            .divider::before {
                left: 0;
            }

            .divider::after {
                right: 0;
            }

        .link {
            text-align: center;
            color: rgba(255,255,255,0.5);
            font-size: 14px;
        }

            .link a {
                color: #e94560;
                text-decoration: none;
                font-weight: 600;
            }

                .link a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>
    <div class="forma">
        <h2>Create Account</h2>
        <p class="subtitle">Fill in your details to register</p>

        @if (ViewBag.Greska != null)
        {
            <div class="greska">@ViewBag.Greska</div>
        }

        <form method="post" action="/Korisnik/Registracija">
            <div class="input-group">
                <label>Username</label>
                <input type="text" name="korisnickoIme" placeholder="Choose a username" required />
            </div>

            <div class="input-group">
                <label>Password</label>
                <input type="password" name="lozinka" placeholder="Choose a password" required />
            </div>

            <div class="row">
                <div class="input-group">
                    <label>First Name</label>
                    <input type="text" name="ime" placeholder="First name" required />
                </div>
                <div class="input-group">
                    <label>Last Name</label>
                    <input type="text" name="prezime" placeholder="Last name" required />
                </div>
            </div>

            <div class="input-group">
                <label>Email</label>
                <input type="email" name="email" placeholder="your@email.com" required />
            </div>

            <div class="row">
                <div class="input-group">
                    <label>Date of Birth (dd/MM/yyyy)</label>
                    <input type="text" name="datumRodjenja" placeholder="15/03/2000" required />
                </div>
                <div class="input-group">
                    <label>Gender</label>
                    <select name="pol">
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
            </div>

            <button type="submit">Create Account</button>
        </form>

        <div class="divider">or</div>
        <div class="link">
            Already have an account? <a href="/Korisnik/Login">Sign In</a>
        </div>
    </div>
</body>
</html>