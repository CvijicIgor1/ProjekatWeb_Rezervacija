@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .forma {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            padding: 45px 40px;
            border-radius: 16px;
            border: 1px solid rgba(255,255,255,0.1);
            width: 380px;
            box-shadow: 0 25px 45px rgba(0,0,0,0.3);
        }

        .logo {
            text-align: center;
            margin-bottom: 30px;
        }

            .logo span {
                font-size: 40px;
            }

        h2 {
            text-align: center;
            color: white;
            margin-bottom: 8px;
            font-size: 24px;
            font-weight: 600;
        }

        .subtitle {
            text-align: center;
            color: rgba(255,255,255,0.5);
            font-size: 14px;
            margin-bottom: 30px;
        }

        .input-group {
            position: relative;
            margin-bottom: 16px;
        }

            .input-group label {
                display: block;
                color: rgba(255,255,255,0.7);
                font-size: 13px;
                margin-bottom: 6px;
            }

            .input-group input {
                width: 100%;
                padding: 12px 16px;
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.15);
                border-radius: 8px;
                color: white;
                font-size: 15px;
                transition: border 0.3s;
                outline: none;
            }

                .input-group input::placeholder {
                    color: rgba(255,255,255,0.3);
                }

                .input-group input:focus {
                    border-color: #e94560;
                    background: rgba(255,255,255,0.12);
                }

        button {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #e94560, #c62a47);
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 16px;
            font-weight: 600;
            margin-top: 8px;
            transition: opacity 0.3s, transform 0.1s;
            letter-spacing: 0.5px;
        }

            button:hover {
                opacity: 0.9;
                transform: translateY(-1px);
            }

            button:active {
                transform: translateY(0);
            }

        .greska {
            background: rgba(233, 69, 96, 0.2);
            border: 1px solid rgba(233, 69, 96, 0.5);
            color: #ff6b8a;
            text-align: center;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 16px;
            font-size: 14px;
        }

        .divider {
            text-align: center;
            color: rgba(255,255,255,0.3);
            margin: 20px 0;
            font-size: 13px;
            position: relative;
        }

            .divider::before, .divider::after {
                content: '';
                position: absolute;
                top: 50%;
                width: 38%;
                height: 1px;
                background: rgba(255,255,255,0.15);
            }

            .divider::before {
                left: 0;
            }

            .divider::after {
                right: 0;
            }

        .link {
            text-align: center;
            color: rgba(255,255,255,0.5);
            font-size: 14px;
        }

            .link a {
                color: #e94560;
                text-decoration: none;
                font-weight: 600;
            }

                .link a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>
    <div class="forma">
        <div class="logo"><span>&#127968;</span></div>
        <h2>Welcome Back</h2>
        <p class="subtitle">Sign in to your account</p>

        @if (ViewBag.Greska != null)
        {
            <div class="greska">@ViewBag.Greska</div>
        }

        <form method="post" action="/Korisnik/Login">
            <div class="input-group">
                <label>Username</label>
                <input type="text" name="korisnickoIme" placeholder="Username" required />
            </div>
            <div class="input-group">
                <label>Password</label>
                <input type="password" name="lozinka" placeholder="Password" required />
            </div>
            <button type="submit">Sign In</button>
        </form>

        <div class="divider">or</div>
        <div class="link">
            Don't have an account? <a href="/Korisnik/Registracija">Register</a>
        </div>
    </div>
</body>
</html>